{
  "name": "forgeseo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm:dev --workspace @forgeseo/api\" \"npm:dev --workspace @forgeseo/worker\" \"npm:dev --workspace @forgeseo/web\"",
    "build": "npm run build --workspaces",
    "test": "npm run typecheck && node --test tests/node/*.test.mjs",
    "typecheck": "tsc -b apps/api apps/worker apps/web packages/shared",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/archiver": "^6.0.3",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.4"
  }
}
