FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --ignore-scripts

COPY apps apps
COPY packages packages
COPY templates templates
RUN npm run build --workspace @forgeseo/shared
RUN npm run build --workspace @forgeseo/worker

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

COPY package.json package-lock.json ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace @forgeseo/worker --workspace @forgeseo/shared

COPY --from=build /app/apps/worker/dist apps/worker/dist
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY templates templates

CMD ["npm", "run", "start", "--workspace", "@forgeseo/worker"]
