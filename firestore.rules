rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExistingDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsNewDocument() {
      return signedIn() && request.resource.data.userId == request.auth.uid;
    }

    function ownsProject(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && userId == request.auth.uid;
    }

    match /projects/{projectId} {
      allow read, update, delete: if ownsExistingDocument();
      allow create: if ownsNewDocument();
    }

    match /generationJobs/{jobId} {
      allow read: if ownsExistingDocument();
      allow write: if false;
    }

    match /pages/{pageId} {
      allow read: if ownsProject(resource.data.projectId);
      allow write: if false;
    }

    match /assets/{assetId} {
      allow read: if ownsProject(resource.data.projectId);
      allow write: if false;
    }

    match /activities/{activityId} {
      allow read: if ownsProject(resource.data.projectId);
      allow write: if false;
    }

    match /templates/{templateId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /deployments/{deploymentId} {
      allow read: if ownsProject(resource.data.projectId);
      allow write: if false;
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
