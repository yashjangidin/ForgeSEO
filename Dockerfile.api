FROM node:22-slim AS build
WORKDIR /app

COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --ignore-scripts

COPY apps apps
COPY packages packages
COPY templates templates
RUN npm run build --workspace @forgeseo/shared
RUN npm run build --workspace @forgeseo/api

FROM node:22-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV API_PORT=8080

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN npm ci --omit=dev --ignore-scripts --workspace @forgeseo/api --workspace @forgeseo/shared

COPY --from=build /app/apps/api/dist apps/api/dist
COPY --from=build /app/packages/shared/dist packages/shared/dist
COPY templates templates

EXPOSE 8080
CMD ["npm", "run", "start", "--workspace", "@forgeseo/api"]
